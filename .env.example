# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=https://YOUR_AUTH_HOST
NEON_AUTH_COOKIE_SECRET=YOUR_RANDOM_COOKIE_SECRET

# Neon Object Storage (server-only)
AWS_ACCESS_KEY_ID=YOUR_NEON_STORAGE_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_NEON_STORAGE_SECRET_ACCESS_KEY
AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH.storage.REGION.aws.neon.tech
AWS_REGION=ap-southeast-1

# App
NEXT_PUBLIC_APP_URL=http://localhost:3003
